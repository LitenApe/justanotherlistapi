<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft.Testing.Extensions.CodeCoverage settings, see the Test step in .github/workflows/pr-quality-gate.yml -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\/]Core\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[\/]Program\.cs$</Source>
        <Source>.*[\/]obj[\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
